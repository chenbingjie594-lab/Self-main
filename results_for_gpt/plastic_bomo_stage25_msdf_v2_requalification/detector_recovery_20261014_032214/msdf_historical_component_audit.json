{
  "stage": "Stage25",
  "scope": "HISTORICAL_CODE_AUDIT_ONLY",
  "base_commit": "91a6fcb4882ea056d796a27367ebd20f2695c3fe",
  "historical_msdf_format_version": 3,
  "stage25_V2_means": "Plastic_Bomo Generation V2 data protocol, NOT a new MSDF version or checkpoint format downgrade",
  "components": [
    {
      "id": "pixel_residual_branch",
      "source": "msdf_guidance.py MSDFAdapter.prepare / pixel_encoder",
      "inputs": [
        "reference_pixels Bx3x512x512 in [-1,1]",
        "reference_mask Bx1x512x512"
      ],
      "outputs": [
        "pixel_encoded Bx64x64x64",
        "last_pixel_support Bx1x64x64"
      ],
      "mechanism": "31-pixel outside-mask local background estimate, masked RGB residual, three stride-2 convolutions, pixel support head",
      "modifies": [
        "conditioning",
        "feature"
      ],
      "trainable": [
        "pixel_encoder",
        "pixel_support_head"
      ],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "latent_semantic_branch",
      "source": "msdf_guidance.py MSDFAdapter.prepare / encoder",
      "inputs": [
        "reference_latents Bx4x64x64 from frozen VAE mode",
        "reference_mask Bx1x64x64"
      ],
      "outputs": [
        "latent_encoded Bx64x64x64"
      ],
      "mechanism": "9-latent-pixel outside-mask background estimate and masked latent residual; concatenated support enters encoder",
      "modifies": [
        "conditioning",
        "feature"
      ],
      "trainable": [
        "encoder"
      ],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "dual_branch_fusion_and_support",
      "source": "msdf_guidance.py MSDFAdapter.prepare",
      "inputs": [
        "latent_encoded",
        "pixel_encoded"
      ],
      "outputs": [
        "encoded Bx64x64x64",
        "reference_support Bx1x64x64"
      ],
      "mechanism": "Concatenate two encoders, fuse with 1x1 convolution. Reference support averages fused support and pixel support. Training branch dropout=0.20, both branches active at inference.",
      "modifies": [
        "feature",
        "conditioning"
      ],
      "trainable": [
        "fusion",
        "support_head"
      ],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "reference_morphology_alignment",
      "source": "msdf_guidance.py MSDFAdapter._align_reference / prepare",
      "inputs": [
        "encoded",
        "reference_support",
        "target_prior"
      ],
      "outputs": [
        "aligned Bx64x64x64",
        "aligned_support Bx1x64x64"
      ],
      "mechanism": "Expanded reference ROI gives aspect and occupied ratio; target prior gives center and maximum extent. Differentiable resized/padded features; discrete geometry uses detached support. Soft halo ring constrained to target extent.",
      "modifies": [
        "feature",
        "conditioning"
      ],
      "trainable": [],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "scale_time_gate",
      "source": "msdf_guidance.py MSDFAdapter.prepare / gate",
      "inputs": [
        "log target mask area",
        "normalized timestep",
        "aligned feature safe RMS"
      ],
      "outputs": [
        "B x 4 scale gates"
      ],
      "mechanism": "Learned MLP, sigmoid cap0.75, smallness-dependent fixed preference for later high-resolution up blocks, recapped0.75.",
      "modifies": [
        "feature",
        "sampling"
      ],
      "trainable": [
        "gate"
      ],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "multi_scale_up_block_injection",
      "source": "msdf_guidance.py MSDFAdapter.attach / _make_hook",
      "inputs": [
        "aligned features",
        "support",
        "gates",
        "UNet up_block hidden"
      ],
      "outputs": [
        "hidden + bounded residual; tuple outputs retain remainder"
      ],
      "mechanism": "Forward hook on all four UNet up blocks, low/high frequency feature mixture, scale-specific zero-initialized1x1 projections. CFG doubles batches with zero unconditional residual.",
      "modifies": [
        "UNet_forward_features"
      ],
      "trainable": [
        "projections.0",
        "projections.1",
        "projections.2",
        "projections.3"
      ],
      "training": true,
      "inference": true,
      "selector": false,
      "SD2_static_channels": [
        1280,
        1280,
        640,
        320
      ],
      "shape_claim": "Static configuration/API inference, not verified by a Stage25 forward."
    },
    {
      "id": "bounded_residual_injection",
      "source": "msdf_guidance.py MSDFAdapter._make_hook",
      "inputs": [
        "projected supported gated residual",
        "hidden RMS"
      ],
      "outputs": [
        "limit * tanh(residual/limit) with limit0.25*hidden_RMS"
      ],
      "mechanism": "Per-sample activation-relative smooth bound, finite guards. Existing _safe_rms adds1e-8. No new numeric fix in Stage25.",
      "modifies": [
        "feature"
      ],
      "trainable": [],
      "training": true,
      "inference": true,
      "selector": false
    },
    {
      "id": "historical_msdf_losses",
      "source": "train_rda.py lines962-1025 plus helpers and morphology_support_loss",
      "inputs": [
        "conditional prediction",
        "noise/velocity target",
        "TRAIN RGB saliency",
        "clean latent target",
        "soft prior",
        "self-reference flag"
      ],
      "outputs": [
        "scalar conditional MSE + weighted six auxiliary losses"
      ],
      "mechanism": "region denoising0.75; reliability-weighted clean reconstruction0.50; gradient structure0.25; outside-prior background0.20; multiscale latent consistency0.25; self-reference morphology support0.25, internally pixel support weight0.50.",
      "modifies": [
        "loss"
      ],
      "trainable": [
        "full UNet",
        "MSDFAdapter"
      ],
      "training": true,
      "inference": false,
      "selector": false
    }
  ],
